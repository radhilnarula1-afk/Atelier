# Copy this file to .env.local and fill in your values

# For local development, leave this empty (defaults to http://localhost:8000)
# For production (Vercel), set this to your deployed Render backend URL
VITE_API_URL=

# Firebase Client configuration (for Google Sign-In support)
# You can find these in Firebase Console -> Project Settings -> General -> Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=atelier-2645c
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
